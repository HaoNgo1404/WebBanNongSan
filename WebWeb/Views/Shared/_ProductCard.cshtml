@model WebWeb.Models.NongSan
@inject WebWeb.Services.KhuyenMaiService KhuyenMaiService

@using WebWeb.Helpers
@{
    var productSlug = Model.TenNongSan.ToSlug();
}

<!-- BAO BỌC TOÀN BỘ PRODUCT CARD BẰNG THẺ A DẪN TỚI TRANG CHI TIẾT -->
<a asp-controller="Product" asp-route-slug="@productSlug" asp-action="Detail" asp-route-id="@Model.NongSanId" class="text-decoration-none text-dark d-block h-100">
    <div class="product-card h-100">
        @{
            bool isConHang = Model.SoLuongTon > 0 && 
                (Model.LoHangs == null || !Model.LoHangs.Any() || Model.LoHangs.Any(l => l.SoLuongTon > 0 && l.HanSuDung >= DateTime.Now));
        }
        <div class="product-card-image">
            <img src="@Url.Content("~/images/" + Model.HinhAnh)" style="width:100%; height:200px; object-fit:cover;" class="rounded-top"
                 alt="@Model.TenNongSan" />
            <!-- HIỂN THỊ BADGE HẾT HÀNG HOẶC HOT -->
            @if (!isConHang)
            {
                <span class="badge bg-danger position-absolute top-0 start-0 m-2 px-3 py-2 rounded-pill fs-6 shadow-sm">
                    <i class="bi bi-x-circle me-1"></i> Hết hàng
                </span>
            }
            else if (Model.IsHot)
            {
                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2 px-2 py-1 rounded-pill small fw-bold shadow-sm">
                    🔥 HOT
                </span>
            }
            <button class="product-fav-btn" type="button" aria-label="Yêu thích" onclick="event.preventDefault(); event.stopPropagation();">
                <i class="bi bi-heart"></i>
            </button>
        </div>
        <div class="product-card-body">
            <div class="product-meta">
                <span class="text-muted small">@(Model.DanhMuc?.TenDanhMuc ?? "Nông sản")</span>
                <span class="text-muted small"><i class="bi bi-star-fill text-warning">@Model.DiemDanhGiaTrungBinh.ToString("0.0")</i></span>
            </div>
            <h5 class="product-card-title">@Model.TenNongSan</h5>
            <p class="product-card-text">@Model.DonViTinh</p>
            <div class="product-card-footer">
                <div>
                    <div class="price">
                        @{
                            decimal giaThucTeCard = KhuyenMaiService.TinhGiaBanThucTe(Model.NongSanId, Model.GiaBanNiemYet);
                        }
                        @if (giaThucTeCard < Model.GiaBanNiemYet)
                        {
                            <span class="fw-bold text-success">@((giaThucTeCard).ToString("#,##0")) VNĐ </span>
                            <span class="text-muted text-decoration-line-through small">@Model.GiaBanNiemYet.ToString("N0") VNĐ </span>
                        }
                        else 
                        {
                            <span class="fw-bold text-success">@Model.GiaBanNiemYet.ToString("N0") VNĐ </span>
                        }
                    </div>
                    <div class="text-muted small">Từ @(string.IsNullOrWhiteSpace(Model.NhaVuon?.TenNhaVuon) ? "Green Fresh" : Model.NhaVuon.TenNhaVuon)</div>
                </div>

                <!-- NÚT GIỎ HÀNG: Đã bỏ thẻ <form> con, dùng onclick chặn nhảy sang trang Detail và gọi hàm quickAddToCart, Khóa nếu hết hàng -->
                @if (isConHang)
                {
                    <button type="button" 
                            class="btn btn-outline-success btn-sm rounded-3 btn-add-to-cart p-0 d-flex align-items-center justify-content-center" 
                            style="width: 36px; height: 36px;"
                            onclick="event.preventDefault(); event.stopPropagation(); quickAddToCart(@Model.NongSanId);" 
                            title="Thêm vào giỏ hàng">
                        <i class="bi bi-cart-plus fs-5"></i>
                    </button>
                }
                else
                {
                    <button type="button" 
                            class="btn btn-secondary btn-sm rounded-3 p-0 d-flex align-items-center justify-content-center opacity-50" 
                            style="width: 36px; height: 36px;" 
                            disabled 
                            onclick="event.preventDefault(); event.stopPropagation();"
                            title="Sản phẩm tạm thời hết hàng">
                        <i class="bi bi-slash-circle fs-5"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</a>