<div id="chatbot-bubble">
    <i class="bi bi-chat-dots-fill"></i>
</div>

<div id="chatbot-box" class="flex-column">
    <div class="chat-header">
        <span class="d-flex align-items-center"><i class="bi bi-robot me-2"></i> Trợ lý ảo Green Fresh</span>
        <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn-expand-chat" id="expand-chat" title="Phóng to">
                <i class="bi bi-arrows-fullscreen" id="expand-icon"></i>
            </button>
            <button type="button" class="btn-close btn-close-white" style="font-size: 12px;" id="close-chat"></button>
        </div>
    </div>
    <div class="chat-messages" id="chat-messages-container">
        @* <div class="message bot">
            Xin chào! Em là trợ lý ảo thông minh của Green Fresh. Em có thể giúp gì cho Anh/Chị hôm nay ạ? 🌱🌸
        </div> *@
    </div>
    <div class="chat-input-area">
        <input type="text" id="user-chat-input" placeholder="Nhập câu hỏi của bạn..." autocomplete="off">
        <button class="btn btn-success btn-sm rounded-circle px-3" id="send-chat-btn">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const bubble = document.getElementById('chatbot-bubble');
        const box = document.getElementById('chatbot-box');
        const closeBtn = document.getElementById('close-chat');
        const sendBtn = document.getElementById('send-chat-btn');
        const inputField = document.getElementById('user-chat-input');
        const messagesContainer = document.getElementById('chat-messages-container');

        // CÁC BIẾN CHO TÍNH NĂNG PHÓNG TO
        const expandBtn = document.getElementById('expand-chat');
        const expandIcon = document.getElementById('expand-icon');

        // Biến lưu câu hỏi gần nhất & trạng thái câu chào
        let lastUserQuery = "";
        let isWelcomeTyped = false; 
        const welcomeMessage = "Xin chào! Em là trợ lý ảo thông minh của Green Fresh. Em có thể giúp gì cho Anh/Chị hôm nay ạ? 🌱🌸";

        // =========================================================================
        // HÀM TẢI PHẢN HỒI TỪ ADMIN CSKH
        // =========================================================================
        function checkAdminReplies() {
            fetch('/api/Bot/danh-sach-tra-loi')
                .then(res => res.json())
                .then(res => {
                    if (res.success && res.data.length > 0) {
                        res.data.forEach(item => {
                            const existingMsg = document.getElementById(`reply-ticket-${item.ticketID}`);
                            if (!existingMsg) {
                                const replyHtml = `
                                    <div id="reply-ticket-${item.ticketID}" class="message bot border border-success bg-light text-dark mb-2 shadow-sm p-2 rounded">
                                        <div class="fw-bold text-success mb-1">
                                            <i class="bi bi-person-check-fill me-1"></i> Admin CSKH đã phản hồi (#TK-${item.ticketID}):
                                        </div>
                                        <div class="small text-muted mb-1"><i>Câu hỏi: "${item.cauHoi}"</i></div>
                                        <div><strong>Trả lời:</strong> ${item.adminTraLoi}</div>
                                        <div class="text-end text-muted mt-1" style="font-size: 10px;">${item.ngayPhanHoi}</div>
                                    </div>
                                `;
                                messagesContainer.insertAdjacentHTML('beforeend', replyHtml);
                                messagesContainer.scrollTop = messagesContainer.scrollHeight;

                                // Đánh dấu ticket này đã được hiển thị/đã đọc
                                fetch(`/api/Bot/da-doc-ticket/${item.ticketID}`, { method: 'POST' });
                            }
                        });
                    }
                })
                .catch(err => console.error("Lỗi tải phản hồi Admin:", err));
        }

        // 1. Click bong bóng để mở/đóng khung chat
        bubble.addEventListener('click', () => {
            const isOpening = (box.style.display !== 'flex');
            box.style.display = isOpening ? 'flex' : 'none';
            inputField.focus();

            if (isOpening) {
                // Tải phản hồi từ Admin mỗi khi người dùng mở khung chat
                checkAdminReplies();

                if (!isWelcomeTyped) {
                    isWelcomeTyped = true;
                    setTimeout(() => {
                        appendMessageWithTypingEffect(welcomeMessage, 'bot');
                    }, 100);
                }
            }
        });

        // 2. Click nút Close để đóng khung chat
        closeBtn.addEventListener('click', () => {
            box.style.display = 'none';
        });

        // 3. Phóng to / Thu nhỏ khung chat
        if (expandBtn) {
            expandBtn.addEventListener('click', () => {
                box.classList.toggle('expanded');
                if (box.classList.contains('expanded')) {
                    expandIcon.className = "bi bi-fullscreen-exit";
                    expandBtn.setAttribute('title', 'Thu nhỏ');
                } else {
                    expandIcon.className = "bi bi-arrows-fullscreen";
                    expandBtn.setAttribute('title', 'Phóng to');
                }
                setTimeout(() => {
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }, 250);
            });
        }

        // 4. Hàm gửi tin nhắn chính
        function sendMessage() {
            const messageText = inputField.value.trim();
            if (!messageText) return;

            // Lưu câu hỏi người dùng vừa nhập
            lastUserQuery = messageText;

            // Hiển thị tin nhắn người dùng lên giao diện
            appendMessage(messageText, 'user');
            inputField.value = '';

            // Hiển thị icon đang suy nghĩ
            const typingIndicatorId = 'typing-' + Date.now();
            appendTypingIndicator(typingIndicatorId);

            // Gửi Ajax lên BotController
            fetch('/api/Bot/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: messageText })
            })
            .then(response => response.json())
            .then(data => {
                removeTypingIndicator(typingIndicatorId);
                
                // Hiển thị câu trả lời AI
                appendMessageWithTypingEffect(data.response, 'bot');

                // XỬ LÝ CHUYỂN SUPPORT TICKET SANG ADMIN:
                if (data.source === "gemini_api_overloaded" || data.source === "gemini_api_error") {
                    // Nếu AI bận/lỗi -> Tự động tạo ticket gửi Admin
                    guiYeuCauChoAdmin(lastUserQuery, true);
                } else {
                    // Nếu AI trả lời bình thường -> Chèn nút để người dùng chủ động gửi nếu chưa vừa ý
                    appendSupportButton(lastUserQuery);
                }
            })
            .catch(error => {
                console.error("Lỗi Chatbot:", error);
                removeTypingIndicator(typingIndicatorId);
                appendMessageWithTypingEffect("Dạ, kết nối mạng của em đang bị gián đoạn. Em sẽ chuyển câu hỏi này cho Admin CSKH xử lý giúp mình ngay nhé!", 'bot');
                guiYeuCauChoAdmin(lastUserQuery, true);
            });
        }

        // Đăng ký sự kiện Gửi tin nhắn
        sendBtn.addEventListener('click', sendMessage);
        inputField.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') sendMessage();
        });

        // 5. Hàm chèn tin nhắn tĩnh của User
        function appendMessage(text, sender) {
            const msgDiv = document.createElement('div');
            msgDiv.classList.add('message', sender);
            msgDiv.innerHTML = text.replace(/\n/g, '<br>');
            messagesContainer.appendChild(msgDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        // 6. Hiển thị tin nhắn của Bot từng dòng (Line-by-line Effect)
        function appendMessageWithTypingEffect(text, sender) {
            const msgDiv = document.createElement('div');
            msgDiv.classList.add('message', sender);
            messagesContainer.appendChild(msgDiv);

            const lines = text.split('\n');
            let lineIndex = 0;
            const lineDelay = 250;

            function showNextLine() {
                if (lineIndex < lines.length) {
                    if (lineIndex > 0) msgDiv.innerHTML += '<br>';
                    msgDiv.innerHTML += lines[lineIndex];
                    lineIndex++;
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                    setTimeout(showNextLine, lineDelay);
                }
            }
            showNextLine();
        }

        // 7. Icon AI đang suy nghĩ
        function appendTypingIndicator(id) {
            const indicatorDiv = document.createElement('div');
            indicatorDiv.id = id;
            indicatorDiv.classList.add('message', 'bot');
            indicatorDiv.innerHTML = `<span class="spinner-grow spinner-grow-sm text-success" role="status"></span> Đang suy nghĩ...`;
            messagesContainer.appendChild(indicatorDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function removeTypingIndicator(id) {
            const elem = document.getElementById(id);
            if (elem) elem.remove();
        }

        // 8. Chèn nút hỗ trợ "Chưa hài lòng? Gửi cho Admin CSKH"
        function appendSupportButton(queryText) {
            setTimeout(() => {
                const btnDiv = document.createElement('div');
                btnDiv.classList.add('text-end', 'mt-1', 'mb-2');
                btnDiv.innerHTML = `
                    <button class="btn btn-outline-success btn-sm rounded-pill py-0 px-2" style="font-size: 11px;" onclick="guiYeuCauChoAdmin('${queryText.replace(/'/g, "\\'")}', false)">
                        <i class="bi bi-headset me-1"></i> Chưa hài lòng? Gửi cho Admin CSKH
                    </button>
                `;
                messagesContainer.appendChild(btnDiv);
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }, 1200);
        }

        // 9. Hàm gửi câu hỏi cho Admin qua API Yêu cầu hỗ trợ
        window.guiYeuCauChoAdmin = function(cauHoiGoc, isAuto) {
            if (!cauHoiGoc) return;

            fetch('/api/Bot/yeu-cau-ho-tro', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cauHoi: cauHoiGoc })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (!isAuto) {
                        appendMessageWithTypingEffect("Dạ em đã chuyển thắc mắc: *\"" + cauHoiGoc + "\"* tới bộ phận CSKH Admin rồi ạ! Admin sẽ xem xét và phản hồi cho mình sớm nhất nha. 🌱", 'bot');
                    }
                }
            })
            .catch(err => console.error("Lỗi gửi Ticket:", err));
        };
    });
</script>
</body>
</html>