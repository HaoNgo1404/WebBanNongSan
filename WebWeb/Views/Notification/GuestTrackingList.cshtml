@model List<WebWeb.Models.DonHangLe>
@{
    ViewData["Title"] = "Kết quả tra cứu đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Kết quả tra cứu</h4>
                        <p class="text-muted small mb-0">Tìm thấy <strong>@Model.Count</strong> đơn hàng cho từ khóa: <span class="badge bg-light text-dark border">@ViewBag.SearchTerm</span></p>
                    </div>
                    <a asp-action="GuestTracking" class="btn btn-outline-secondary btn-sm rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Tìm từ khóa khác
                    </a>
                </div>

                <div class="list-group list-group-flush">
                    @foreach (var donHang in Model)
                    {
                        string rawData = $"{donHang.DonHangLeId}_{(donHang.DiaChi?.SoDienThoaiNhan ?? donHang.PhoneNonAccount)}_GuestSecretKey";
                        string token = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(rawData));

                        <a asp-action="GuestTrackingDetail" asp-route-orderId="@donHang.DonHangLeId" asp-route-token="@token" 
                           class="list-group-item list-group-item-action py-3 px-3 mb-2 rounded-3 border">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 fw-bold text-success">
                                    <i class="bi bi-bag-check me-1"></i> Đơn hàng #@donHang.DonHangLeId
                                </h6>
                                <span class="badge bg-primary rounded-pill">@donHang.TrangThaiDonHang</span>
                            </div>
                            <div class="row text-muted small">
                                <div class="col-6">
                                    <i class="bi bi-clock me-1"></i> @donHang.NgayDat.ToString("dd/MM/yyyy HH:mm")
                                </div>
                                <div class="col-6 text-end">
                                    Tổng tiền: <strong class="text-danger">@donHang.TongTienThucTe.ToString("N0")₫</strong>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>