@model IEnumerable<WebWeb.Models.SupportTicket>
@{
    ViewData["Title"] = "Quản lý CSKH";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card border-0 shadow-sm rounded-3 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-headset text-success me-2"></i>Trung tâm CSKH & Hỗ trợ Chatbot</h4>
            <p class="text-muted small mb-0">Xử lý các câu hỏi thắc mắc của khách hàng mà AI chưa tự trả lời được.</p>
        </div>
    </div>

    <!-- Bộ lọc trạng thái -->
    <div class="mb-3 d-flex gap-2">
        <a href="@Url.Action("Index", "Cskh", new { trangThai = "TatCa" })" class="btn btn-sm @(ViewBag.TrangThaiHienTai == "TatCa" ? "btn-success" : "btn-outline-secondary")">Tất cả</a>
        
        <a href="@Url.Action("Index", "Cskh", new { trangThai = WebWeb.Models.OrderStatuses.ChoXuLy })" class="btn btn-sm @(ViewBag.TrangThaiHienTai == WebWeb.Models.OrderStatuses.ChoXuLy ? "btn-warning text-dark" : "btn-outline-warning")">Chờ xử lý</a>
        
        <!-- Gửi param "DaXuLy" để Controller biết cần lấy cả Đã trả lời & Đã xem -->
        <a href="@Url.Action("Index", "Cskh", new { trangThai = "DaXuLy" })" class="btn btn-sm @(ViewBag.TrangThaiHienTai == WebWeb.Models.OrderStatuses.DaXem || ViewBag.TrangThaiHienTai == WebWeb.Models.OrderStatuses.DaTraLoi ? "btn-info text-white" : "btn-outline-info")">Đã xử lý</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle border">
            <thead class="table-light">
                <tr>
                    <th>Mã Ticket</th>
                    <th>Khách hàng</th>
                    <th>Câu hỏi</th>
                    <th>Ngày gửi</th>
                    <th>Trạng thái</th>
                    <th>Người xử lý</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-success">#TK-@item.TicketID.ToString("D4")</td>
                            <td>
                                <span class="fw-semibold text-dark">@item.TenKhachHang</span>
                                @if (!string.IsNullOrEmpty(item.EmailLienHe))
                                {
                                    <br /><small class="text-muted">@item.EmailLienHe</small>
                                }
                            </td>
                            <td style="max-width: 280px;">
                                <span class="text-wrap">@item.CauHoi</span>
                            </td>
                            <td><small class="text-muted">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</small></td>
                            <td>
                                @if (item.TrangThai == WebWeb.Models.OrderStatuses.ChoXuLy)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i> Chờ xử lý</span>
                                }
                                else if (item.TrangThai == WebWeb.Models.OrderStatuses.DaTraLoi || item.TrangThai == WebWeb.Models.OrderStatuses.DaXem)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Đã trả lời</span>
                                }
                                @* else if (item.TrangThai == WebWeb.Models.OrderStatuses.DaXem)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-eye-fill me-1"></i> Khách đã xem</span>
                                } *@
                            </td>
                            <td>
                                @(item.NhanVien != null ? item.NhanVien.HoTen : (!string.IsNullOrEmpty(item.AdminTraLoi) ? "Admin" : "-"))
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#replyModal-@item.TicketID">
                                    <i class="bi bi-reply-fill"></i> @(item.TrangThai == WebWeb.Models.OrderStatuses.ChoXuLy ? "Trả lời" : "Xem/Sửa")
                                </button>

                                <!-- MODAL TRẢ LỜI -->
                                <div class="modal fade text-start" id="replyModal-@item.TicketID" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="TraLoi" method="post">
                                                <input type="hidden" name="ticketId" value="@item.TicketID" />
                                                <div class="modal-header bg-success text-white">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-chat-left-text-fill me-2"></i>Phản hồi Ticket #TK-@item.TicketID</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3 bg-light p-3 rounded border">
                                                        <label class="fw-bold text-muted small">CÂU HỎI CỦA KHÁCH:</label>
                                                        <p class="mb-0 text-dark fw-semibold">"@item.CauHoi"</p>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">Câu trả lời của Admin:</label>
                                                        <textarea name="noiDungTraLoi" class="form-control" rows="4" placeholder="Nhập nội dung phản hồi..." required>@item.AdminTraLoi</textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn btn-success"><i class="bi bi-send-fill me-1"></i> Gửi phản hồi</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Hiện không có câu hỏi nào cần xử lý.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>